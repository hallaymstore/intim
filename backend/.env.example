NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/yaqin

# Kamida 32 belgili tasodifiy qatorlar (production'da majburiy)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Frontend manzil(lar)i, vergul bilan
CLIENT_ORIGIN=http://localhost:3000
# HTTPS ortida true qiling
COOKIE_SECURE=false

# Cloudflare R2 (bo'sh qoldirilsa, rasmlar lokal uploads/ papkasiga saqlanadi)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Bucketning ommaviy manzili (custom domen yoki r2.dev), oxirida / siz
R2_PUBLIC_URL=

# npm run seed shu admin'ni yaratadi
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!12345
